APP_ENV=development
SECRET_KEY=change-me-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=english_learning
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=storage
# none = no AI | local = faster-whisper (speech-to-text) + rule-based scoring (+ Ollama if LLM_MODEL is set)
AI_PROVIDER=none

# --- Social login (leave empty to disable) ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Google: https://console.cloud.google.com/apis/credentials  -> redirect URI: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps  -> redirect URI: {BACKEND_URL}/api/v1/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email for "forgot password" (leave SMTP_HOST empty in dev: the link is printed in the backend console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hoc cung Phao <no-reply@example.com>

# --- Local AI (only used when AI_PROVIDER=local). Install: pip install -r requirements-ai.txt ---
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE=int8
# Optional: install Ollama (https://ollama.com), run `ollama pull llama3.2:3b`, then set:
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
AI_TIMEOUT=90
